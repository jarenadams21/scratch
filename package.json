{
  "name": "harbinger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run load-config && concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "load-config": "node scripts/load-config.js",
    "build": "npm run load-config && npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:prod": "cp config/flags.prod.yml config/flags.yml && npm run load-config && cd frontend && npm run build:prod",
    "preview": "cd frontend && npm run preview",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "deploy": "./scripts/deploy/deploy.sh",
    "setup:prod": "./scripts/deploy/setup-production.sh"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^8.2.2",
    "undici-types": "^8.2.0",
    "yaml": "^2.3.4"
  }
}
